[Unit]
Description=FastWAM RoboTwin formal three-way comparison
After=graphical-session.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/sj/fastwam/FastWAM-git
Environment=PATH=/home/ubuntu/miniconda3/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=MAX_ATTEMPTS=3
ExecStart=/usr/bin/bash /home/ubuntu/sj/fastwam/FastWAM-git/scripts/run_robotwin_multitask3_wan_head_awr_formal_compare.sh
Restart=on-failure
